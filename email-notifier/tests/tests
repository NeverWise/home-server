time="2024-11-14T21:08:01Z" level=info msg="msmtp: could not send mail" channel=stderr iteration=0 job.command=send-emails job.position=0 job.schedule="* * * * *"
time="2024-11-14T21:08:01Z" level=info msg="Error during sending the 'Test Email' email." channel=stderr iteration=0 job.command=send-emails job.position=0 job.schedule="* * * * *"
time="2024-11-14T21:08:01Z" level=error msg="error running command: exit status 77" iteration=0 job.command=send-emails job.position=0 job.schedule="* * * * *"
time="2024-11-14T21:08:01Z" level=debug msg="job will run next at 2024-11-14 21:09:00 +0000 UTC" job.command=send-emails job.position=0 job.schedule="* * * * *"
