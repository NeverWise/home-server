time="2024-11-14T21:08:19Z" level=info msg="waiting for jobs to finish"
time="2024-11-14T21:08:19Z" level=debug msg="shutting down" job.command=send-emails job.position=0 job.schedule="* * * * *"
time="2024-11-14T21:08:19Z" level=info msg=exiting
EOF
errors=$(diff "$TEST_PATH/expectations/logger_log" "$TEST_FILE")
tmp_exit_code=$?
if [ $tmp_exit_code -eq 0 ]; then
    echo -e "$GREEN✔$NC$test_name"
else
    echo -e "$RED✘$NC$test_name"
    echo "$errors"
    exit_code="$tmp_exit_code"
fi
rm -rf "$TEST_FILE"

echo

exit $exit_code
