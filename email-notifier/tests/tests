#!/bin/sh

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

exit_code=0

# Verify /etc/crontab and try to send a test email
echo -e '\nVerify /etc/crontab and try to send a test email'
supercronic -test /etc/crontab
tmp_exit_code=$?
if [ $tmp_exit_code -eq 0 ]; then

    echo -e "$GREEN✔$NC crontab test passed successfully"

    email_file_path=$(create-test-email)

    send-emails
    tmp_exit_code=$?

    if [ $tmp_exit_code -eq 0 ] && [ ! -f "$email_file_path" ]; then
        echo -e "$GREEN✔$NC Email sent successfully. Please check the recipients ($RECIPIENTS) for the test email"
    else
        echo -e "$RED✘$NC Error during email sending"
        if [ $tmp_exit_code -eq 0 ]; then
            exit_code=1
        else
            exit_code="$tmp_exit_code"
        fi
    fi
else
    exit_code=$tmp_exit_code
    echo -e "$RED✘$NC Invalid crontab"
fi

TEST_PATH=$(echo $PATH | cut -d : -f 2)
export TEST_FILE="$TEST_PATH/test_file"

# NOTE $1 is the file name.
# NOTE $2 is the $DISPLAY_NAME environment variable.
# NOTE $3 is the $FROM environment variable.
# NOTE $4 is the $RECIPIENTS environment variable.
test() {
    USER='sender@example.com'
    DISPLAY_NAME="$2"
    FROM="$3"
    RECIPIENTS=$([ -n "$4" ] && echo "$4" || echo 'mail1@example.com')

    test_name=" Test $1"
    create-test-email >/dev/null
    send-emails >/dev/null
    errors=$(diff "$TEST_PATH/expectations/$1" "$TEST_FILE")
    error_code=$?
    if [ $error_code -eq 0 ]; then
        echo -e "$GREEN✔$NC$test_name"
    else
        echo -e "$RED✘$NC$test_name"
        echo "$errors"
    fi
    rm -rf "$TEST_FILE"
    return $error_code
}

# Define the path of the mocked msmtp to be created.
mocked_msmtp="$TEST_PATH/msmtp"

# Create the mocked msmtp and write the Bourne shell script into it.
cat <<'EOF' >"$mocked_msmtp"
#!/bin/sh

# Read the input from stdin.
input_from_stdout=''
while read LINE; do
  input_from_stdout="$input_from_stdout$LINE\n"
done

# Print the input.
echo -e "$input_from_stdout" > "$TEST_FILE" # Save email to file.
EOF

# Make the new mocked msmtp executable.
chmod +x "$mocked_msmtp"

echo -e '\nVerify email composition'

# Test comma separated recipients (not allowed) and $USER as sender
test 'comma separated recipients (not allowed) and $USER as sender' '' '' 'mail1@example.com,mail2@example.com'
tmp_exit_code=$?
if [ $tmp_exit_code -ne 0 ]; then
    exit_code="$tmp_exit_code"
fi

# Test semicolon separated recipients (not allowed) and $USER with $DISPLAY_NAME
test 'semicolon separated recipients (not allowed) and $USER with $DISPLAY_NAME' 'Mario' '' 'mail1@example.com;mail2@example.com'
tmp_exit_code=$?
if [ $tmp_exit_code -ne 0 ]; then
    exit_code="$tmp_exit_code"
fi

# Test space separated recipients (allowed) and $FROM over $USER
test 'space separated recipients (allowed) and $FROM over $USER' '' 'test@example.com' 'mail1@example.com mail2@example.com'
tmp_exit_code=$?
if [ $tmp_exit_code -ne 0 ]; then
    exit_code="$tmp_exit_code"
fi

# Test colon separated recipients (allowed) and $FROM with $DISPLAY_NAME
test 'colon separated recipients (allowed) and $FROM with $DISPLAY_NAME' 'Mario' 'test@example.com' 'mail1@example.com:mail2@example.com'
tmp_exit_code=$?
if [ $tmp_exit_code -ne 0 ]; then
    exit_code="$tmp_exit_code"
fi

echo -e '\nTest `send-email` outcomes'

cat <<'EOF' >"$mocked_msmtp"
#!/bin/sh
exit 1
EOF

test_name=' Test error during email sending'
email_file_path=$(create-test-email)
email_file_name=$(basename "$email_file_path")
message=$(send-emails 2>&1)
send_email_exit_code=$?
if [ $send_email_exit_code -ne 0 ] && [ "$message" = "Error during sending the '$email_file_name' email." ] && [ -f "$email_file_path" ]; then
    echo -e "$GREEN✔$NC$test_name"
else
    echo -e "$RED✘$NC$test_name"
    exit_code=1
fi

cat <<'EOF' >"$mocked_msmtp"
#!/bin/sh
exit 0
EOF

test_name=' Test successfully email sent'
message=$(send-emails)
send_email_exit_code=$?
if [ $send_email_exit_code -eq 0 ] && [ "$message" = "Email '$email_file_name' sent successfully." ] && [ ! -f "$email_file_path" ]; then
    echo -e "$GREEN✔$NC$test_name"
else
    echo -e "$RED✘$NC$test_name"
    exit_code=1
fi

test_name=' Test no email to send'
message=$(send-emails)
send_email_exit_code=$?
if [ $send_email_exit_code -eq 0 ] && [ "$message" = 'No email to send.' ]; then
    echo -e "$GREEN✔$NC$test_name"
else
    echo -e "$RED✘$NC$test_name"
    exit_code=1
fi

# Remove the mocked msmtp.
rm -rf "$mocked_msmtp"

echo -e '\nTest logger'

# Test logger
test_name=' Test processing of the supercronic log by the logger'
# The example log below is generated by the command `supercronic -debug /etc/crontab [2>> some_file]`
cat <<'EOF' | logger > "$TEST_FILE"
